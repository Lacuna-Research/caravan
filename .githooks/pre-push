#!/usr/bin/env bash
# Installed by: make hooks
set -euo pipefail

branch=$(git rev-parse --abbrev-ref HEAD)

# The name EnterWorktree would have generated for *this* worktree, which is exactly
# `worktree-<directory>`. Matching that rather than the bare `worktree-*` prefix: a branch
# genuinely about worktrees is not an unrenamed one, and this hook refused to push
# `worktree-hygiene` from the directory `worktree-hygiene` — where the generated name
# would have been `worktree-worktree-hygiene`.
generated="worktree-$(basename "$(git rev-parse --show-toplevel)")"

case "$branch" in
"$generated")
	echo "pre-push: refusing to push '$branch'." >&2
	echo >&2
	echo "  EnterWorktree names its branch 'worktree-<name>'. Rename it first:" >&2
	echo "      git branch -m <name>" >&2
	echo >&2
	echo "  Pushing to a different name instead (git push origin HEAD:<name>) leaves" >&2
	echo "  the local branch with no upstream, which also blinds the stale-worktree" >&2
	echo "  check in Scripts/check-worktree.sh." >&2
	exit 1
	;;
esac
